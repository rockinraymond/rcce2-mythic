    If Upper(Class(Target)) <> "ANIMAL"
        Output(Player, "Strengthen Animal can only target animals", 255, 100, 100)
        Return
    EndIf
    SpellCost = 3
    ResourceName$ = "Spirit"
    SpellName$ = "Strengthen Animal"
