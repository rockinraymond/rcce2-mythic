    CastingLevel = FindCastingLevel(Attribute(Player, "Divine Casting"), ActorLevel(Player))
    EffectValue = 2 + CastingLevel
    EffectDuration = 300
    EffectTexID = Parameter(2)
    SkillName$ = "Divine Casting"
    GoverningAttribute$ = "Wisdom"
    castingTime = 5
    HitSound = 30
    EmitterName$ = "BuffBlue"
    EmitterTex = 337
    ModifyAttributeSpell(Player, Target, SpellCost, ResourceName$, SpellName$, EffectName$, EffectAttribute$, EffectValue, EffectDuration, EffectTexID, SkillName$, GoverningAttribute$, castingTime, HitSound, EmitterName$, EmitterTex)
End Function

Function Spell_Striking()
    Player = Actor()
    Target = ContextActor()
    If Target = 0 Then Target = Player
    SpellCost = 3
    ResourceName$ = "Spirit"
    SpellName$ = "Striking"
    EffectName$ = "Striking"
    EffectAttribute$ = "Damage Bonus"
    CastingLevel = FindCastingLevel(Attribute(Player, "Divine Casting"), ActorLevel(Player))
    EffectValue = 2 + CastingLevel
    EffectDuration = 300
    EffectTexID = Parameter(2)
