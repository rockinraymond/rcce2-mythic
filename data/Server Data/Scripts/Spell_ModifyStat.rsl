Function ApplyPartyAttributeSpell(Player, SpellCost, SpellName$, EffectName$, EffectAttribute$, EffectValue, EffectDuration, EffectTexID, EmitterName$, EmitterTex)
    If Attribute(Player, "Health") <= 0
        Output(Player, "You cannot cast spells when you are dead", 255, 255, 0)
        Return 0
    EndIf
    If ActorHasEffect(Player, "Casting")
        Output(Player, "You are already casting a spell", 255, 0, 255)
        Return 0
    EndIf
    If Attribute(Player, "Mana") < SpellCost
        Output(Player, "Not enough Mana", 255, 0, 0)
        Return 0
    EndIf
    If ArcaneEquipmentCheck(Player) < 1
        Output(Player, "You cannot cast Arcane spells with your current equipment", 255, 50, 50)
        Return 0
    EndIf

    CastingTime = 5
    SetAttribute(Player, "Mana", Attribute(Player, "Mana") - SpellCost)
    ZZRUNABILITYCOOLDOWN(Player, SpellName$)
    ZZADDSKILLXP(Player, "Arcane Casting", SpellCost * 10)
    AnimateActor(Player, "Cast Magic", 0.005, 1)
    Output(Player, "Casting " + SpellName$, 200, 0, 255)
    AddActorEffect(Player, "Casting", "Movement", -100, CastingTime, 0)
    PlaySound(Player, 28, 0)
    CreateEmitter(Player, "arcaneCasting", 356, 5000)

    Bar = CreateProgressBar(Player,200,0,225,.4,.8,.2,.04,CastingTime * 10,0,SpellName$)
    i = 0
    Repeat
        UpdateProgressBar(Player, Bar, i)
        DoEvents(100)
        i = i + 1
        If Attribute(Player, "Health") <= 0
            DeleteProgressBar(Player, Bar)
            Return 0
        EndIf
    Until i >= CastingTime * 10
    DeleteProgressBar(Player, Bar)

    FinalEffectValue = EffectValue + AbilityBonus(Attribute(Player, "Intelligence"))
    If EffectValue < 0 And FinalEffectValue > -1 Then FinalEffectValue = -1
    If EffectValue > 0 And FinalEffectValue < 1 Then FinalEffectValue = 1

    Members = CountPartyMembers(Player)
    Count = 1
    Repeat
        Member = PartyMember(Player, Count)
        If Member > 0
            AddActorEffect(Member, EffectName$, EffectAttribute$, FinalEffectValue, EffectDuration, EffectTexID)
            CreateEmitter(Member, EmitterName$, EmitterTex, 4000)
        EndIf
        Count = Count + 1
    Until Count > Members

    AddActorEffect(Player, EffectName$, EffectAttribute$, FinalEffectValue, EffectDuration, EffectTexID)
    CreateEmitter(Player, EmitterName$, EmitterTex, 4000)
    If SpellName$ = "Group Shield"
        Output(Player, "A magical shield surrounds your party.", 150, 255, 150)
    Else
        Output(Player, "Your party fades from sight.", 150, 255, 150)
    EndIf
    Return 1
End Function

Function Spell_GroupShield()
    Player = Actor()
    SpellCost = 3
    SpellName$ = "Group Shield"
    EffectName$ = "Group Shield"
    EffectAttribute$ = "Armor Bonus"
    CastingLevel = FindCastingLevel(Attribute(Player, "Arcane Casting"), ActorLevel(Player))
    EffectValue = 2 + CastingLevel
    If EffectValue < 3 Then EffectValue = 3
    EffectDuration = 300
    EffectTexID = Parameter(2)
    EmitterName$ = "BuffBlue"
    EmitterTex = 337
    ApplyPartyAttributeSpell(Player, SpellCost, SpellName$, EffectName$, EffectAttribute$, EffectValue, EffectDuration, EffectTexID, EmitterName$, EmitterTex)
End Function

