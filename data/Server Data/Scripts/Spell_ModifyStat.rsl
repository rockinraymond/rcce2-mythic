Using "RC_Core.rcm"
Function Main()
End Function

Function ModifyAttributeSpell(Player, Target, SpellCost, ResourceName$, SpellName$, EffectName$, EffectAttribute$, EffectValue, EffectDuration, EffectTexID, SkillName$, GoverningAttribute$, castingTime , HitSound = 30, EmitterName$ = "BuffRed", EmitterTex = 337, isResist = 0, SaveType$ = "Spells")

    PlayerName$ = Name(Player)
    TargetName$ = Name(Target)

    CastingSound = 1

    CastingEmitterTex = 356
    CastingEmitter$ = "arcaneCasting"

    If SkillName$ = "Divine Casting"
        CastingEmitter$ = "divineCasting"
    EndIf

    SuccessChance = 10 + GetSkillModifier(Attribute(Player,SkillName$))

    FinalEffectValue = EffectValue

    If EffectValue < 0
        SuccessChance = SuccessChance  - Resistance(Target, SaveType$)
        FinalEffectValue = FinalEffectValue - AbilityBonus(Attribute(Player,GoverningAttribute$))
    Else
        FinalEffectValue = FinalEffectValue + AbilityBonus(Attribute(Player,GoverningAttribute$))
    EndIf

    If SuccessChance < 1 Then SuccessChance = 1
    If SuccessChance > 19 Then SuccessChance = 19

    If EffectValue < 0 And FinalEffectValue > -1
        FinalEffectValue = -1
    ElseIf EffectValue > 0 And FinalEffectValue < 1
        FinalEffectValue = 1
    EndIf

    If CastingChecks(Player, Target, SkillName$) < 1
        Return 0
    EndIf

    ;Player vs Player Check
    If EffectValue < 0
        If ActorIsHuman(Target) > 0
            Output(Player, "Cannot target player, PVP not enabled!",255, 50, 50)
            Return 0
        EndIf
    EndIf

    ;Check the mana
    ResourceAmt = Attribute(Player, ResourceName$)
    If(ResourceAmt < SpellCost)
        Output(Player, "Not enough " + ResourceName$, 255, 0, 0)
        Return 0
    EndIf
    SetAttribute(Player, ResourceName$, ResourceAmt - SpellCost)

    ZZRUNABILITYCOOLDOWN(Player, SpellName$)
    ;Particles and casting animation
    AnimateActor(Player, "Cast Magic", 0.005, 1)
    Output(Player, "Casting " + SpellName$, 200, 0, 255) 
	AddActorEffect(Player, "Casting", "Movement", -100, castingTime,0)
    PlaySound(Player, CastingSound, 0)
    CreateEmitter(Player, CastingEmitter$, CastingEmitterTex, 5000)
    
    ;create progress bar
	bar = CreateProgressBar(Player,200,0,225,.4,.8,.2,.04,castingTime * 10,0,SpellName$)
	Repeat
	UpdateProgressBar(Player,bar,i)
    DoEvents(100)
    i =  i + 1
    If(Attribute(Player, "Health") < 0)
        Output(Player, "You cannot cast spells when you are dead",255, 255, 0)
        DeleteProgressBar(Player,Bar)
        Return
    EndIf
	Until i = castingTime * 10
	DeleteProgressBar(Player,Bar)

    ;Checking for Aggression
    If EffectValue < 0
        If ActorTarget(Target) = 0
            SetActorTarget(Target, Player)
            SetActorAIState(Target, 3)
        EndIf
    EndIf

    ZZADDSKILLXP(Player, SkillName$, SpellCost * 10)
    
    SpellSuccess = Rand(1,20)

    If SpellSuccess <= SuccessChance
        If isResist > 0 And EffectAttribute$ <> "Armor Bonus"
            If EffectValue < 0
                Outcome$ = TargetName$ + " becomes vulnerable to " + EffectAttribute$ + " damage."
            Else
                Outcome$ = TargetName$ + " gains resistance to " + EffectAttribute$ + " damage."
            EndIf
        ElseIf EffectAttribute$ = "Movement"
            If EffectValue < 0
                Outcome$ = TargetName$ + " is slowed."
            Else
                Outcome$ = TargetName$ + " moves faster."
            EndIf
        ElseIf EffectAttribute$ = "ATK Speed Mod"
            If EffectValue < 0
                Outcome$ = TargetName$ + " attacks slower."
            Else
                Outcome$ = TargetName$ + " attacks faster."
            EndIf
        ElseIf EffectAttribute$ = "Stealth Mod"
            Outcome$ = TargetName$ + " fades from sight."
        ElseIf EffectAttribute$ = "Strength"
            Outcome$ = TargetName$ + " feels stronger."
        ElseIf EffectAttribute$ = "Damage Bonus"
            Outcome$ = TargetName$ + "'s strikes hit harder."
        ElseIf EffectAttribute$ = "Armor Bonus"
            Outcome$ = TargetName$ + " is protected by a magical shield."
        ElseIf EffectAttribute$ = "Attack Bonus"
            Outcome$ = TargetName$ + "'s attacks become more accurate."
        ElseIf EffectAttribute$ = "Carry Weight Mod"
            Outcome$ = TargetName$ + " can carry more weight."
        Else
            Outcome$ = SpellName$ + " takes effect on " + TargetName$ + "."
        EndIf
        Output(Player, Outcome$, 100, 255, 150)
        If Target <> Player Then Output(Target, PlayerName$ + " casts " + SpellName$ + " on you.", 100, 255, 150)
        
        ;visuals and effect
        CreateEmitter(Target, EmitterName$, EmitterTex, 4000)
        PlaySound(Player, HitSound, 0)
        PlaySound(Target, HitSound, 0)
	    AddActorEffect(Target, EffectName$, EffectAttribute$, FinalEffectValue, EffectDuration, EffectTexID, isResist)
        
    Else
         If Target = Player
            Output(Target,  "Your " + SpellName$ + " spell has failed!", 255, 100, 100)
        Else
            Output(Player, "Your " + SpellName$ + " spell has missed " + TargetName$ + "!",255, 100, 100)
            Output(Target, PlayerName$ + "'s " + SpellName$ + " has missed you!", 255, 100, 100)
        EndIf
    EndIf
    Return 0

End Function

Function CastingChecks(Player,Target,SpellSchool$)
    ;is player dead?
    If(Attribute(Player, "Health") < 0)
        Output(Player, "You cannot cast spells when you are dead",255, 255, 0)
        Return 0
    EndIf
    If ActorHasEffect(Player, "Silenced")
        Output(Player, "You cannot cast spells while silenced", 255, 100, 100)
        Return 0
    EndIf

    ;Casting Check
    If ActorHasEffect(Player, "Casting")
        OutPut(Player, "You are already casting a spell!", 255, 0, 255)
    Return 0
    EndIf

    ;NPC Check
    If ActorIsHuman(Target) = 0 And Actoraggressiveness(Target) = 3
        Output(Player, "You cannot target non-combat NPCs with spells", 255, 50, 50)
        Return 0
    EndIf

    ;Check if the target is correct?
    If(Target = 0)
        Output(Player, "No Valid Target Selected",255, 50, 50)
        Return 0
    EndIf

    If (ActorDistance(Player, Target) > 100.0)
        Output(Player, "You are too far away from target!",255, 255, 0)
        Return 0
    EndIf

    ;Check Equipment
    If SpellSchool$ = "Arcane Casting"
        If ArcaneEquipmentCheck(Player) < 1
            Output(Player, "You cannot cast Arcane spells with your current equipment",255, 50, 50)
            Return 0
        EndIf
    EndIf

    If SpellSchool$ = "Divine Casting"
        If ClericEquipmentCheck(Player) < 1
            Output(Player, "You cannot cast Divine spells with your current weapon",255, 50, 50)
            Return 0
        EndIf
    EndIf

    Return 1

End Function

Function ArcaneEquipmentCheck(Player)
    Result = 1
    PlayerRace$ = Race(Player)

    ;Actor Equipment
    PlayerWeapon = ActorWeapon(Player)
    PlayerShield = ActorShield(Player)
    PlayerChest = ActorChest(Player)
    PlayerHat = ActorHat(Player)
    PlayerLegs = ActorLegs(Player)
    PlayerHands = ActorHands(Player)
    PlayerFeet = ActorFeet(Player)
    PlayerBelt = ActorBelt(Player)

    If PlayerShield > 0
        Result = 0
    EndIf

    Select PlayerRace$
        Case "Elf"
            If ZZITEMARMORCLASS(PlayerChest) = 3
                Result = 0
            EndIf
            If ZZITEMARMORCLASS(PlayerHat) = 3
                Result = 0
            EndIf
            If ZZITEMARMORCLASS(PlayerLegs) = 3
                Result = 0
            EndIf
            If ZZITEMARMORCLASS(PlayerHands) = 3
                Result = 0
            EndIf
            If ZZITEMARMORCLASS(PlayerFeet) = 3
                Result = 0
            EndIf
            If ZZITEMARMORCLASS(PlayerBelt) = 3
                Result = 0
            EndIf
            If ItemWeaponType(PlayerWeapon) = 3 
                Result = 0
            EndIf

        Case "Gnome"
            If (ZZITEMARMORCLASS(PlayerChest) = 3) OR (ZZITEMARMORCLASS(PlayerChest) = 2)
                Result = 0
            EndIf
            If (ZZITEMARMORCLASS(PlayerHat) = 3) OR (ZZITEMARMORCLASS(PlayerHat) = 2)
                Result = 0
            EndIf
            If (ZZITEMARMORCLASS(PlayerLegs) = 3) OR (ZZITEMARMORCLASS(PlayerLegs) = 2)
                Result = 0
            EndIf
            If (ZZITEMARMORCLASS(PlayerHands) = 3) OR (ZZITEMARMORCLASS(PlayerHands) = 2)
                Result = 0
            EndIf
            If (ZZITEMARMORCLASS(PlayerFeet) = 3) OR (ZZITEMARMORCLASS(PlayerFeet) = 2)
                Result = 0
            EndIf
            If (ZZITEMARMORCLASS(PlayerBelt) = 3) OR (ZZITEMARMORCLASS(PlayerBelt) = 2)
                Result = 0
            EndIf
            If (ItemWeaponType(PlayerWeapon) = 3) OR (ItemWeaponType(PlayerWeapon) = 2)
                Result = 0
            EndIf

        Case "Half Elf"
           If (ZZITEMARMORCLASS(PlayerChest) = 3) OR (ZZITEMARMORCLASS(PlayerChest) = 2)
                Result = 0
            EndIf
            If (ZZITEMARMORCLASS(PlayerHat) = 3) OR (ZZITEMARMORCLASS(PlayerHat) = 2)
                Result = 0
            EndIf
            If (ZZITEMARMORCLASS(PlayerLegs) = 3) OR (ZZITEMARMORCLASS(PlayerLegs) = 2)
                Result = 0
            EndIf
            If (ZZITEMARMORCLASS(PlayerHands) = 3) OR (ZZITEMARMORCLASS(PlayerHands) = 2)
                Result = 0
            EndIf
            If (ZZITEMARMORCLASS(PlayerFeet) = 3) OR (ZZITEMARMORCLASS(PlayerFeet) = 2)
                Result = 0
            EndIf
            If (ZZITEMARMORCLASS(PlayerBelt) = 3) OR (ZZITEMARMORCLASS(PlayerBelt) = 2)
                Result = 0
            EndIf
            If ItemWeaponType(PlayerWeapon) = 3 
                Result = 0
            EndIf

        Default
            If (ZZITEMARMORCLASS(PlayerChest) = 3) OR (ZZITEMARMORCLASS(PlayerChest) = 2) OR (ZZITEMARMORCLASS(PlayerChest) = 1)
                Result = 0
            EndIf
            If (ZZITEMARMORCLASS(PlayerHat) = 3) OR (ZZITEMARMORCLASS(PlayerHat) = 2) OR (ZZITEMARMORCLASS(PlayerHat) = 1)
                Result = 0
            EndIf
            If (ZZITEMARMORCLASS(PlayerLegs) = 3) OR (ZZITEMARMORCLASS(PlayerLegs) = 2) OR (ZZITEMARMORCLASS(PlayerLegs) = 1)
                Result = 0
            EndIf
            If (ZZITEMARMORCLASS(PlayerHands) = 3) OR (ZZITEMARMORCLASS(PlayerHands) = 2) OR (ZZITEMARMORCLASS(PlayerHands) = 1)
                Result = 0
            EndIf
            If (ZZITEMARMORCLASS(PlayerFeet) = 3) OR (ZZITEMARMORCLASS(PlayerFeet) = 2) OR (ZZITEMARMORCLASS(PlayerFeet) = 1)
                Result = 0
            EndIf
            If (ZZITEMARMORCLASS(PlayerBelt) = 3) OR (ZZITEMARMORCLASS(PlayerBelt) = 2) OR (ZZITEMARMORCLASS(PlayerBelt) = 1)
                Result = 0
                Result = 0
            EndIf
            If ItemWeaponType(PlayerWeapon) = 3 
                Result = 0
            EndIf
            If (ZZITEMWEAPONCLASS(PlayerWeapon) = 1) OR ((ZZITEMWEAPONCLASS(PlayerWeapon) > 2) AND (ZZITEMWEAPONCLASS(PlayerWeapon) < 7))
                Result = 0
            EndIf
    End Select

    Return Result

End Function

Function ClericEquipmentCheck(Player)
    Result = 1

    ;Actor Equipment
    PlayerWeapon = ActorWeapon(Player)
    
        If (ZZITEMWEAPONCLASS(PlayerWeapon) = 1) OR (ZZITEMWEAPONCLASS(PlayerWeapon) = 2) OR (ZZITEMWEAPONCLASS(PlayerWeapon) = 4) OR (ZZITEMWEAPONCLASS(PlayerWeapon) = 5) OR (ZZITEMWEAPONCLASS(PlayerWeapon) = 6) OR (ZZITEMWEAPONCLASS(PlayerWeapon) = 8)
            Result = 0
        EndIf
    

    Return Result

End Function


Function Spell_Shield()
    Player = Actor()
    Target = ContextActor()
    If Target = 0
        Target = Player
    EndIf
    SpellCost = 1
    CastingLevel = FindCastingLevel(Attribute(Player, "Arcane Casting"), ActorLevel(Player))
    ResourceName$ = "Mana"
    SpellName$ = "Shield"
    castingTime = 5
    EffectName$ = "Shield"
    EffectAttribute$ = "Armor Bonus"
    EffectValue = 2 + CastingLevel
    EffectDuration = 180
    EffectTexID = Parameter(2)
    SkillName$ = "Arcane Casting"
    GoverningAttribute$ = "Intelligence"

    CastingSound = 28
    EmitterName$ = "BuffBlue"
    EmitterTex = 337

    ModifyAttributeSpell(Player, Target, SpellCost, ResourceName$, SpellName$, EffectName$, EffectAttribute$, EffectValue, EffectDuration, EffectTexID, SkillName$, GoverningAttribute$, castingTime,CastingSound, EmitterName$,EmitterTex)
   
End Function

