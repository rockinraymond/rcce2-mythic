End Function

Function Spell_BestowCourage()
    Player = Actor()
    Target = ContextActor()
    If Target = 0 Then Target = Player
    If CastingChecks(Player, Target, "Divine Casting") < 1
        Return
    EndIf
    SpellCost = 1
    If Attribute(Player, "Spirit") < SpellCost
        Output(Player, "Not enough Spirit", 255, 0, 0)
        Return
    EndIf
    SetAttribute(Player, "Spirit", Attribute(Player, "Spirit") - SpellCost)
    ZZRUNABILITYCOOLDOWN(Player, "Bestow Courage")
    ZZADDSKILLXP(Player, "Divine Casting", SpellCost * 10)
    AnimateActor(Player, "Cast Magic", 0.05, 1)
    AddActorEffect(Player, "Casting", "Movement", -100, 2, 0)
    CreateEmitter(Player, "divineCasting", 356, 3000)
    Output(Player, "Casting Bestow Courage", 200, 0, 255)
    Bar = CreateProgressBar(Player,200,255,200,.4,.8,.2,.04,20,0,"Bestow Courage")
    i = 0
    Repeat
        UpdateProgressBar(Player, Bar, i)
        DoEvents(100)
        i = i + 1
        If Attribute(Player, "Health") <= 0
            DeleteProgressBar(Player, Bar)
            Return
        EndIf
    Until i >= 20
    DeleteProgressBar(Player, Bar)
    If ActorHasEffect(Target, "Fear")
        DeleteActorEffect(Target, "Fear")
        CreateEmitter(Target, "BuffBlue", 337, 3000)
        Output(Player, Name(Target) + " is no longer afraid.", 150, 255, 150)
        If Target <> Player Then Output(Target, "Your fear is gone.", 150, 255, 150)
    Else
        Output(Player, Name(Target) + " is not afraid; Bestow Courage has no effect.", 255, 180, 100)
    EndIf
End Function

Function Spell_StrengthenAnimal()
    Player = Actor()
