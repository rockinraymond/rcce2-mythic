Using "RC_Core.rcm"
; Define entry function 'Main'

Function Main()
    Mob = Actor()
    MobLevel = ActorLevel(Mob)

    MobHP = 0
    If MobLevel > 0
        For x = 1 to MobLevel Step 1
            MobHP = (MobHP + Rand(1,8))
        Next
    Else
        MobHp = Rand(1,4)
    EndIf

    SETMaXATTRIBUTE(Mob, "Health", MobHP )
    SETATTRIBUTE(Mob, "Health", MobHP )



    If Race(Mob) = "Orc"
        GiveItem(Mob, "Long Sword", 1)
    ElseIf Race(Mob) = "Goblin"
        GiveItem(Mob, "Short Spear", 1)
    ElseIf Race(Mob) = "Hobgoblin"
        GiveItem(Mob, "Short Sword", 1)
    ElseIf Race(Mob) = "Gnoll"
        GiveItem(Mob, "Battle Axe", 1)
    ElseIf Race(Mob) = "Bugbear"
        GiveItem(Mob, "Morning Star", 1)
    ElseIf Race(Mob) = "Dwarf"
        SETATTRIBUTE(Mob, "Strength", 12)
        SETATTRIBUTE(Mob, "Toughness", 14)
        SETATTRIBUTE(Mob, "Agility", 10)
        SETATTRIBUTE(Mob, "Dexterity", 9)

        GiveItem(Mob, "Battle Axe", 1)
        GiveItem(Mob, "Chainmail Armor", 1)
        GiveItem(Mob, "Round Shield", 1)
    ElseIf Race(Mob) = "Human"
        SETATTRIBUTE(Mob, "Strength", 11)
        SETATTRIBUTE(Mob, "Toughness", 11)
        SETATTRIBUTE(Mob, "Agility", 11)
        SETATTRIBUTE(Mob, "Dexterity", 1)

        GiveItem(Mob, "Mace", 1)
        GiveItem(Mob, "Chainmail Armor", 1)
        GiveItem(Mob, "Round Shield", 1)
    
    ElseIf Race(Mob) = "Elf"
        SETATTRIBUTE(Mob, "Strength", 9)
        SETATTRIBUTE(Mob, "Toughness", 10)
        SETATTRIBUTE(Mob, "Agility", 12)
        SETATTRIBUTE(Mob, "Dexterity", 10)

        GiveItem(Mob, "Short Bow", 1)
        GiveItem(Mob, "Leather Armor", 1)
        GiveItem(Mob, "Arrow", 100)

    
    ElseIf Race(Mob) = "Halfling"
        SETATTRIBUTE(Mob, "Strength", 9)
        SETATTRIBUTE(Mob, "Toughness", 10)
        SETATTRIBUTE(Mob, "Agility", 12)
        SETATTRIBUTE(Mob, "Dexterity", 10)

        GiveItem(Mob, "Short Sword", 1)
        GiveItem(Mob, "Leather Armor", 1)
        
    EndIf

End Function